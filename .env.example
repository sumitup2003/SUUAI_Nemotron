# --- Nemotron (NVIDIA build.nvidia.com) ---
# Get a free key at https://build.nvidia.com -> pick a Nemotron model -> "Get API Key"
NEMOTRON_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# You can override the default model per-request from the UI, but this is the fallback.
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# --- Supabase (free tier) ---
# Create a free project at https://supabase.com, then Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service role key - server-only, never exposed to the browser. Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
